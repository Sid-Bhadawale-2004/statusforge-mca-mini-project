# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# StatusForge Backend Configuration
PORT=3000
NODE_ENV="development"

# MongoDB Connection URI (Optional in development; auto-fallbacks to persistent JSON-backed MongoDB store if unreachable)
MONGODB_URI="mongodb://localhost:27017/statusforge"

# JWT Secrets
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="replace-with-a-unique-refresh-secret"

# Redis / Background Job Queue Configuration
REDIS_URL="redis://localhost:6379"
ESCALATION_WORKER_INTERVAL_MS=2000

# Email Notifications (SMTP)
SMTP_HOST="smtp.statusforge.internal"
SMTP_PORT=587
SMTP_USER="alerts@statusforge.io"
