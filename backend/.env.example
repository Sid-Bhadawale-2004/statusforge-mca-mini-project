PORT=5000
MONGODB_URI=mongodb://localhost:27017/statusforge
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:3000
NODE_ENV=development
SEED_DEFAULT_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# ─── Email (Resend HTTPS API recommended for hosted deployments) ────────────────
# Gmail API uses HTTPS and sends from the authorized Gmail account.
# Enable Gmail API in Google Cloud, grant gmail.send, and authorize the sender account.
# For OAuth Playground, authorize redirect URI https://developers.google.com/oauthplayground.
# Gmail API takes priority over Resend and SMTP when all four values are set.
# GMAIL_API_CLIENT_ID=your_google_oauth_client_id
# GMAIL_API_CLIENT_SECRET=your_google_oauth_client_secret
# GMAIL_API_REFRESH_TOKEN=your_gmail_api_refresh_token
# GMAIL_API_SENDER=StatusForge <you@gmail.com>

# Verify a sending domain in Resend, then use a sender address from that domain.
# On Render, add RESEND_API_KEY and EMAIL_FROM to the backend service environment.
# Resend is used only when Gmail API credentials are not fully configured.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM="StatusForge <alerts@your-verified-domain.com>"

# Optional SMTP fallback for local development
# For Gmail: enable "App Passwords" in your Google Account (2FA must be on)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="StatusForge Alerts <your_gmail@gmail.com>"

# Google Identity Services OAuth 2.0 Web client ID.
# Configure the same client ID in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
